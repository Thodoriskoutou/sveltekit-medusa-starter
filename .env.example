# Copy to `.env` and fill in. Vars are declared and validated in src/env.ts.

# --- Medusa (required) ---
MEDUSA_BACKEND_URL="http://localhost:9000"
MEDUSA_PUBLISHABLE_KEY=""

# --- Medusa (optional) ---
# Pin a region, or let the SDK resolve one from the visitor's country.
MEDUSA_DEFAULT_REGION_ID=""
MEDUSA_DEFAULT_COUNTRY_CODE="us"

# --- Stripe (optional until you enable payments) ---
STRIPE_KEY=""
STRIPE_REDIRECT_URL="http://localhost:5173/checkout/return"

# --- Site metadata ---
SITE_NAME="My Store"
SITE_URL="http://localhost:5173"
